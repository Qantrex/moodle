MAX_NAME = 120                                                  # characters; file systems stop at 255 bytes


def task_name(name, fallback="Assignment", keep_ext=False):
    """Exact task name, sanitizing only what Linux paths or Obsidian LiveSync forbid (\\/:*?\"<>|#), plus what
    breaks syncing: a leading dot (hidden: sync would never find the note again), trailing dots, overlong names."""
    s = re.sub(r"[\x00-\x1f\x7f]+", " ", name)
    s = re.sub(r"\s*:\s*", " - ", s).replace('"', "'").replace("/", "-")
    s = re.sub(r"[\\?<>|*#]+", "", s)
    s = re.sub(r"\s+", " ", s).strip()
    if len(s) > MAX_NAME:
        stem, ext = os.path.splitext(s) if keep_ext else (s, "")
        ext = ext if len(ext) <= 10 else ""
        s = stem[:MAX_NAME - len(ext)].rstrip() + ext
    s = s.lstrip(". ").rstrip(". ")
    return s or fallback


def kind_of(a):
    return "test" if TEST_NAME.search(a["name"]) else "assignment"


def yaml_val(v):
    s = str("" if v is None else v)
    if not s:
        return ""
    if (": " in s or " #" in s or s.endswith(":") or any(c in s for c in '"\\\n\r\t')
            or s[0] in "#[{*&!|>%@`?'\"-" or s != s.strip()):
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def unquote_yaml(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        inner = s[1:-1]
        return inner.replace('\\"', '"').replace("\\\\", "\\") if s[0] == '"' else inner.replace("''", "'")
    return s


def props_of(text):
    m = FM.match(text)
    if not m:
        return {}
    return {k: unquote_yaml(v) for k, v in re.findall(r"^([\w-]+):[ \t]*(.*?)[ \t]*$", m.group(1), re.M)}


def yaml_line(key, value):
    val = yaml_val(value)
    return "%s: %s" % (key, val) if val != "" else "%s:" % key


def set_prop(text, key, value):
    line = yaml_line(key, value)
    m = FM.match(text)
    if not m:
        return "---\n%s\n---\n" % line + text
    fm = m.group(1)
    if re.search(r"^%s:.*$" % re.escape(key), fm, re.M):
        fm = re.sub(r"^%s:.*$" % re.escape(key), lambda _: line, fm, count=1, flags=re.M)
    else:
        fm += "\n" + line
    return "---\n" + fm + "\n---\n" + text[m.end():]


def put_block(text, content):
    start, end = "<!-- moodle -->", "<!-- /moodle -->"
    block = "%s\n%s\n%s" % (start, content.strip(), end)
    if start in text and end in text:
        return text[:text.index(start)] + block + text[text.index(end) + len(end):]
    return text.rstrip() + "\n\n" + block + "\n"


def strip_volatile(text):
    t = re.sub(r"^updated:[ \t]*.*$", "updated:", text, count=1, flags=re.M)
    return re.sub(r"^\*synced [^*]+ by `moodle`; edit outside this block\*$"
                  r"|^\*synced [^*]+ by `moodle sync`; edit outside this block\*$", "*synced*", t, count=1, flags=re.M)


def existing_notes():
    """cmid -> note path, for notes that already carry `moodle: <cmid>`."""
    out = {}
    if not os.path.isdir(NOTES):
        return out
    for d, dirs, fs in os.walk(NOTES):
        dirs[:] = [x for x in dirs if not x.startswith(".") and not os.path.islink(os.path.join(d, x))]
        for f in fs:
            if f.endswith(".md"):
                p = os.path.join(d, f)
                cm = props_of(read_text(p) or "").get("moodle", "")
                if cm.isdigit():
                    out[int(cm)] = p
    return out


NOISE = {
    "group", "gruppe", "aufgabe", "abgabe", "assignment", "task", "teil", "part", "übung", "uebung",
    "sem09", "2627", "2526", "borm", "erarbeit", "erarbeiten", "wissenschaftliches", "arbeiten",
}
SHORT_TERMS = {"ci", "cd", "qt", "ai", "da", "vm", "db", "ui", "os", "ip"}
SYNONYMS = {"restore": "recovery"}


def words(s):
    out = set()
    for w in re.findall(r"[a-zäöüß0-9]+", s.lower()):
        w = SYNONYMS.get(w, w)
        if w in NOISE or w.upper() in SUBJECTS or re.fullmatch(r"[a-z]{2,5}\d+[a-z]", w):
            continue
        if len(w) >= 4 or w in SHORT_TERMS:
            out.add(w)
    return out


def candidate_tracker_notes(subject_dir, linked):
    if not os.path.isdir(subject_dir):
        return
    for entry in sorted(os.listdir(subject_dir)):
        if entry.startswith("."):
            continue
        p = os.path.join(subject_dir, entry)
        if os.path.islink(p):
            continue
        if os.path.isfile(p) and entry.endswith(".md") and p not in linked:
            yield p
        elif os.path.isdir(p):
            for sub in sorted(os.listdir(p)):
                sp = os.path.join(p, sub)
                if sub.endswith(".md") and sub != "TASK.md" and os.path.isfile(sp) and not os.path.islink(sp) and sp not in linked:
                    yield sp


def match_by_name(a, linked):
    """An existing tracker note in the same subject (not yet linked to Moodle) whose title or repo matches."""
    if not a["subject"]:
        return None
    folder = os.path.join(NOTES, a["subject"])
    want = words(a["name"])
    is_ek = bool(re.search(r"(?<![a-z])ek\d*(?![a-z])", a["name"].lower()))
    body = "%s\n%s" % (a.get("intro") or "", a.get("activity") or "")
    c50 = {s.lower() for s in re.findall(r"classroom50\.org/[^\s)\"'>]+/assignments/([a-z0-9_-]+)", body, re.I)}
    best = None
    for p in candidate_tracker_notes(folder, linked):
        text = read_text(p)
        if text is None:
            continue
        pr = props_of(text)
        if pr.get("moodle") or pr.get("type") not in ("assignment", "test"):
            continue
        stem = os.path.basename(p)[:-3]
        files_base = os.path.basename(pr.get("files", "")).lower()
        slug_hit = any(s in files_base or s in stem.lower() for s in c50)
        h1 = re.search(r"^# (.+)$", text, re.M)
        note_title = "%s %s" % (stem, h1.group(1) if h1 else "")
        note_ek = bool(re.search(r"(?<![a-z])ek\d*(?![a-z])", note_title.lower()))
        if is_ek != note_ek and not slug_hit:
            continue
        have = words("%s %s" % (note_title, files_base))
        shared = len(want & have)
        score = (10 + shared) if slug_hit else shared
        if slug_hit or (want and (shared >= 2 or (shared and shared / len(want | have) >= 0.5))):
            if not best or score > best[0]:
                best = (score, p)
    return best and best[1]


def md_file_link(path):
    label = os.path.basename(path).replace("[", r"\[").replace("]", r"\]")
    return "[%s](file://%s)" % (label, urllib.parse.quote(path, safe="/:@"))


def extra_instructions(a):
    act = (a.get("activity") or "").strip()
    return act if act and act != (a.get("intro") or "").strip() else ""


def task_md_for(a):
    lines = ["<!-- moodle -->", "# %s" % heading_for(a), "",
             "- **Task:** %s" % a["name"],
             "- **Course:** %s" % a["course"],
             "- **Moodle:** %s" % a["url"],
             "- **Due:** %s" % when(a["due"])]
    if a["cutoff"] and a["cutoff"] != a["due"]:
        lines.append("- **Last chance (cut-off):** %s" % when(a["cutoff"]))
    if a["opens"] and a["opens"] > now_ts():
        lines.append("- **Opens:** %s" % when(a["opens"]))
    if a["intro"]:
        lines += ["", "## Task", "", a["intro"]]
    act = extra_instructions(a)
    if act:
        lines += ["", "## Instructions", "", act]
    if not a["intro"] and not act:
        lines += ["", "*(No task description in Moodle.)*"]
    return "\n".join(lines) + "\n"


def block_for(a, dl_dir, saved, has_task_md=False):
    lines = ["## Moodle", "",
             "*synced %s by `moodle sync`; edit outside this block*" % local(now_ts()).strftime("%Y-%m-%d %H:%M"), "",
             "- **Link:** %s" % a["url"], "- **Course:** %s" % a["course"], "- **Due:** %s" % when(a["due"])]
    if a["cutoff"] and a["cutoff"] != a["due"]:
        lines.append("- **Last chance (cut-off):** %s" % when(a["cutoff"]))
    if a["opens"] and a["opens"] > now_ts():
        lines.append("- **Opens:** %s" % when(a["opens"]))
    sub_label = "no online submission" if a.get("state") == "none" else a.get("state", "?")
    lines.append("- **Submission:** %s%s" % (sub_label, ", graded: %s" % a["grade"] if a.get("grade") else ""))
    fb = (a.get("feedback") or "").strip()
    if fb and "\n" not in fb and len(fb) <= 140:
        lines.append("- **Feedback:** %s" % fb)
    if has_task_md:
        lines.append("- **Task:** [TASK.md](TASK.md)")
    if dl_dir and (saved or os.path.isdir(dl_dir)):
        lines.append("- **Files:** %s" % md_file_link(dl_dir))
        lines += ["  - %s" % s for s in saved]
    if fb and ("\n" in fb or len(fb) > 140):
        lines += ["", "### Feedback", "", fb]
    if not has_task_md:
        if a["intro"]:
            lines += ["", "### Task", "", a["intro"]]
        act = extra_instructions(a)
        if act:
            lines += ["", "### Instructions", "", act]
    return "\n".join(lines)


def heading_for(a):
    clean = re.sub(r"  +", " ", re.sub(r"\s*:\s*", " ", a["name"])).strip()
    if re.match(r"^%s\b" % re.escape(a["subject"]), clean, re.I):
        return clean
    return "%s — %s" % (a["subject"], clean)


def todo_for(a):
    mark = "x" if done(a) else " "
    kind = kind_of(a)
    verb = "Exam / check on" if kind == "test" else ("Complete by" if a.get("state") == "none" else "Hand in by")
    if a["due"]:
        return "> - [%s] %s **%s**." % (mark, verb, when(a["due"]))
    return "> - [%s] %s (no due date in Moodle)." % (mark, "Exam / check" if kind == "test" else "Hand in")


def sync_auto_todo(text, a):
    """Keep auto-generated todo checkboxes and due dates in sync without touching custom user todos."""
    def repl(m):
        line = todo_for(a)
        if m.group(1) == "x" and not done(a):
            line = line.replace("> - [ ] ", "> - [x] ", 1)
        return line
    text = AUTO_TODO.sub(repl, text, count=1)
    if done(a):
        text = TEMPLATE_TODO.sub(r"\1x\2", text, count=1)
    return text


def new_note(a, files_dir):
    fm = "\n".join([
        yaml_line("type", kind_of(a)),
        yaml_line("subject", a["subject"]),
        yaml_line("year", a["year"]),
        yaml_line("status", "done" if done(a) else "open"),
        yaml_line("due", day(a["due"])),
        yaml_line("files", files_dir),
        yaml_line("moodle", a["cmid"]),
        yaml_line("updated", today().isoformat()),
    ])
    return "---\n%s\n---\n# %s\n\n> [!todo]\n%s\n" % (fm, heading_for(a), todo_for(a))


def is_git(d):
    return bool(d) and os.path.exists(os.path.join(d, ".git"))


def attachment_names(files):
    """(local file name, file) pairs: names made safe like task names, and unique within the folder."""
    used, out = set(), []
    for f in files:
        name = task_name(os.path.basename(f["filename"]), fallback="attachment", keep_ext=True)
        stem, ext = os.path.splitext(name)
        n = 2
        while name.lower() in used:
            name = "%s (%d)%s" % (stem, n, ext)
            n += 1
        used.add(name.lower())
        out.append((name, f))
    return out


def pick_new_note_path(subject, name, cmid, claimed):
    """<notes>/<subject>/<Exact Task Name>/<Exact Task Name>.md"""
    tname = task_name(name)
    folder = os.path.join(NOTES, subject, tname)
    p = os.path.join(folder, tname + ".md")
    if p in claimed or os.path.exists(p):
        tname = "%s (%d)" % (tname, cmid)
        folder = os.path.join(NOTES, subject, tname)
        p = os.path.join(folder, tname + ".md")
    return p


def resolve_files_dir(x, is_existing, old_props, claimed_dirs, create_work_dir=False):
    """Return (frontmatter_files_value, attachment_download_dir)."""
    already_finished = done(x) or old_props.get("status") in ("done", "dropped")
    exact = os.path.join(FILES, x["subject"], task_name(x["name"]))
    if exact in claimed_dirs:
        exact = "%s (%d)" % (exact, x["cmid"])
    existing_files = old_props.get("files", "").strip() if is_existing else ""
    if existing_files:
        where = os.path.abspath(os.path.expanduser(existing_files))
        in_files = where.startswith(os.path.abspath(FILES) + os.sep)
        if in_files and not is_git(where):
            claimed_dirs.add(where)
            return existing_files, (where if os.path.isdir(where) or not already_finished else None)
        if x["files"] and not is_git(exact) and (os.path.isdir(exact) or not already_finished):
            claimed_dirs.add(exact)
            return existing_files, exact
        return existing_files, None
    if os.path.isdir(exact) or ((x["files"] or create_work_dir) and not already_finished):
        claimed_dirs.add(exact)
        return exact, (None if is_git(exact) else exact)          # a repo cloned there is yours: no downloads
    return "", None


def sync_task_md(note_dir, x, dry_run):
    """Ensure TASK.md inside the vault's assignment folder holds the exact Moodle task description."""
    p = os.path.join(note_dir, "TASK.md")
    if os.path.exists(p):
        old = read_text(p)
        if old is None or "<!-- moodle -->" not in old:
            return False
    else:
        old = None
    content = task_md_for(x)
    if old == content:
        return False
    if not dry_run:
        write_atomic(p, content)
    return True


def sync_one(x, path, have, claimed_notes, claimed_dirs, token, downloads, create_work_dir=False, no_files=False,
             dry_run=False, how=""):
    """Write or update one assignment's note, TASK.md and working/attachment folder. Returns 'new'|'updated'|'unchanged'."""
    is_existing = bool(path and os.path.exists(path))
    old_text = read_text(path) if is_existing else ""
    if old_text is None:
        return "unchanged"
    old_props = props_of(old_text) if is_existing else {}
    if not path:
        path = pick_new_note_path(x["subject"], x["name"], x["cmid"], claimed_notes)
        have[x["cmid"]] = path
        claimed_notes.add(path)

    subject_root = os.path.abspath(os.path.join(NOTES, x["subject"]))
    note_dir = os.path.abspath(os.path.dirname(path))
    in_task_folder = note_dir != subject_root

    files_prop, dl_dir = resolve_files_dir(x, is_existing, old_props, claimed_dirs,
                                           create_work_dir=(create_work_dir and not no_files))
    if create_work_dir and dl_dir and not no_files and not dry_run:
        os.makedirs(dl_dir, exist_ok=True)

    saved = []
    for fname, f in attachment_names(x["files"] if dl_dir and not no_files else []):
        dest = os.path.join(dl_dir, fname)
        plan = downloads.plan(dest, f)
        if plan == "beside":
            fname = beside_name(fname, f)
            dest = os.path.join(dl_dir, fname)
            plan = downloads.plan(dest, f)
            if plan == "get":
                log("  %s was edited here and changed in Moodle: keeping yours, new one saved as %s" % (
                    os.path.basename(dest), fname))
        if plan == "get" and not dry_run:
            try:
                download(f["fileurl"], dest, token, mtime=f.get("timemodified"), size=f.get("filesize"))
            except DownloadError as e:
                log("  can't download %s: %s" % (fname, e))
                continue
            downloads.remember(dest, f)
        saved.append(fname)

    task_changed = sync_task_md(note_dir, x, dry_run) if in_task_folder else False

    if is_existing:
        text = old_text
        if not FM.match(text):
            text = new_note(x, files_prop) + "\n" + text
        if x["due"]:
            text = set_prop(text, "due", day(x["due"]))
        if not old_props.get("files", "").strip() and files_prop:
            text = set_prop(text, "files", files_prop)
        if done(x) and old_props.get("status") not in ("done", "dropped"):
            text = set_prop(text, "status", "done")
        text = sync_auto_todo(text, x)
        text = set_prop(set_prop(text, "moodle", x["cmid"]), "updated", today().isoformat())
    else:
        text = new_note(x, files_prop)

    has_dl = dl_dir if (dl_dir and (saved or os.path.isdir(dl_dir) or (create_work_dir and not no_files))) else None
    text = put_block(text, block_for(x, has_dl, saved, has_task_md=in_task_folder))

    if is_existing and not task_changed and strip_volatile(old_text) == strip_volatile(text):
        return "unchanged"

    verb = "update" if is_existing else "new   "
    print("%s %-5s %-10s %-10s %s%s" % (verb, x["subject"], day(x["due"]) or "-", x.get("state", "?"),
                                        os.path.relpath(path, NOTES), how))
    if not dry_run:
        write_atomic(path, text)
    return "updated" if is_existing else "new"


def parse_cmid(s):
    if re.search(r"/(course|user|grade)/", s):
        fail("that's not an assignment link (open the assignment and copy its link): %r" % s)
    m = re.search(r"[?&](?:cm)?id=(\d+)", s) or re.fullmatch(r"\s*(\d+)\s*", s)
    if not m:
        fail("give an assignment link (…/mod/assign/view.php?id=N) or its id: %r" % s)
    return int(m.group(1))


def cmd_add(a):
    want_ids = [parse_cmid(s) for s in a.assignments]
    by_id = {x["cmid"]: x for x in assignments(all_years=True, with_status=False)}
    picked = []
    for cid in want_ids:
        x = by_id.get(cid)
        if not x:
            fail("assignment %d isn't in my courses (or Moodle hides it)" % cid)
        if not x["subject"]:
            fail("no subject for course %r; add it to %s" % (x["course"], SUBJECTS_FILE))
        picked.append(x)

    enrich_status(picked)
    have = existing_notes()
    claimed_notes = set(have.values())
    claimed_dirs = set()
    token = read_token()
    downloads = Downloads()
    counts = {"new": 0, "updated": 0, "unchanged": 0}
    skipped_done = 0

    for x in picked:
        path = have.get(x["cmid"])
        how = ""
        if not path:
            path = match_by_name(x, claimed_notes)
            if path:
                how = " (linked by name: check it's the same assignment)"
                have[x["cmid"]] = path
                claimed_notes.add(path)
        if not path and done(x) and not a.force:
            skipped_done += 1
            log("skip (already finished/graded; pass --force to create anyway): %s" % x["name"])
            continue
        res = sync_one(x, path, have, claimed_notes, claimed_dirs, token, downloads,
                       create_work_dir=True, no_files=a.no_files, dry_run=a.dry_run, how=how)
        counts[res] += 1
    if not a.dry_run:
        downloads.save()

    log("%d new, %d updated, %d unchanged%s%s" % (
        counts["new"], counts["updated"], counts["unchanged"],
        ", %d already done" % skipped_done if skipped_done else "",
        " — dry run, nothing written" if a.dry_run else ""))


def cmd_sync(a):
    raw = assignments(with_status=False)
    have = existing_notes()
    claimed_notes = set(have.values())
    matched = []
    unmapped = sorted({x["course"] for x in raw if not x["subject"]})
    if unmapped:
        log("no subject for %s (add to %s to sync them)" % (", ".join(unmapped), SUBJECTS_FILE))
    for x in raw:
        if not x["subject"]:
            continue
        path = have.get(x["cmid"])
        how = ""
        if not path:
            path = match_by_name(x, claimed_notes)
            if path:
                how = " (linked by name: check it's the same assignment)"
                have[x["cmid"]] = path
                claimed_notes.add(path)
        if path and os.path.exists(path):
            matched.append((x, path, how))

    enrich_status([x for x, _, _ in matched])
    token = read_token() if matched else ""
    downloads = Downloads()
    claimed_dirs = set()
    counts = {"new": 0, "updated": 0, "unchanged": 0}

    for x, path, how in matched:
        res = sync_one(x, path, have, claimed_notes, claimed_dirs, token, downloads,
                       create_work_dir=False, no_files=a.no_files, dry_run=a.dry_run, how=how)
        counts[res] += 1
    if not a.dry_run:
        downloads.save()

    log("%d updated, %d unchanged (tracked notes only; use `moodle add <id>` to create a new task folder)%s" % (
        counts["updated"], counts["unchanged"], " — dry run, nothing written" if a.dry_run else ""))


