# ---- token ----------------------------------------------------------------------------------------------------

def read_token():
    global _token_cache
    if _token_cache:
        return _token_cache
    cmd = os.environ.get("MOODLE_TOKEN_CMD")                 # e.g. 'rbw get "TGM Moodle token"'
    if cmd:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            _token_cache = r.stdout.strip()
            return _token_cache
        fail("MOODLE_TOKEN_CMD failed")
    try:
        _token_cache = open(TOKEN_FILE).read().strip()
        return _token_cache
    except OSError:
        fail("no token yet: run `moodle token` once (in a normal terminal)")


def parse_token(raw, passport):
    """A plain 32-hex token, or the moodlemobile://token=<base64> link that the SSO launch redirects to."""
    raw = raw.strip()
    if re.fullmatch(r"[0-9a-f]{32}", raw):
        return raw
    m = re.search(r"token=([A-Za-z0-9+/=_-]+)", raw)
    if not m:
        fail("that's neither a token nor a moodlemobile://token=… link")
    b64 = m.group(1).replace("-", "+").replace("_", "/")
    parts = base64.b64decode(b64 + "=" * (-len(b64) % 4)).decode().split(":::")
    if len(parts) < 2:
        fail("the link doesn't contain a token")
    if passport and parts[0] != hashlib.md5((SITE + passport).encode()).hexdigest():
        log("warning: the link wasn't made for this login request (old link?); trying the token anyway")
    return parts[1]


def cmd_token(a):
    passport = "%d" % secrets.randbelow(10 ** 9)
    url = "%s/admin/tool/mobile/launch.php?service=moodle_mobile_app&passport=%s&urlscheme=moodlemobile&oauthsso=1" % (
        SITE, passport)
    print("1. Log in to Moodle in your browser as usual (TGM Single Sign On).\n"
          "2. In the same browser, open:\n\n   %s\n\n"
          "3. The browser tries to open a moodlemobile:// link. Cancel that dialog. Open DevTools (F12) → Network\n"
          "   (reload the link if the list is empty). Pick the LAST launch.php request, the one ending in '&confirmed'\n"
          "   with status 302, and copy the value of its 'location' response header (moodlemobile://token=…).\n"
          "   Paste it only here, not in a chat: it works like a password for your Moodle account.\n"
          "   Or: if %s/user/managetoken.php shows a 'Moodle mobile web service' key, copy that key.\n" % (url, SITE))
    raw = getpass.getpass("4. Paste the link or the key (hidden): ")
    token = parse_token(raw, passport)
    info = call("core_webservice_get_site_info", token=token)
    os.makedirs(CONF, mode=0o700, exist_ok=True)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(token + "\n")
    print("ok: logged in as %s (%s); token saved in %s (only you can read it)" % (
        info.get("fullname"), info.get("username"), TOKEN_FILE))


# ---- API ------------------------------------------------------------------------------------------------------

def flatten(prefix, v, out):
    if isinstance(v, (list, tuple)):
        for i, x in enumerate(v):
            flatten("%s[%d]" % (prefix, i), x, out)
    elif isinstance(v, dict):
        for k, x in v.items():
            flatten("%s[%s]" % (prefix, k), x, out)
    else:
        out.append((prefix, str(v)))


def call(fn, token=None, **args):
    data = [("wstoken", token or read_token()), ("wsfunction", fn), ("moodlewsrestformat", "json")]
    for k, v in args.items():
        flatten(k, v, data)
    req = urllib.request.Request(SITE + "/webservice/rest/server.php", data=urllib.parse.urlencode(data).encode(),
                                 headers={"User-Agent": UA})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                raw = r.read().decode("utf-8", "replace")
            out = json.loads(raw)
            break
        except (urllib.error.URLError, TimeoutError, ConnectionError, ValueError) as e:
            if attempt == 2:
                fail("can't reach %s: %s" % (SITE, e))
            time.sleep(3 * (attempt + 1))
    if isinstance(out, dict) and out.get("exception"):
        code = out.get("errorcode") or ""
        if code == "invalidtoken" or (code == "accessexception" and fn.startswith("core_")):
            fail("Moodle refused the token (%s). Run `moodle token` again." % code)
        raise MoodleError("%s: %s" % (fn, out.get("message") or code))
    return out


def download(url, dest, token, mtime=None):
    sep = "&" if "?" in url else "?"
    req = urllib.request.Request(url + sep + "token=" + token, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=60) as r:
        body = r.read()
    if body[:1] == b"{" and b'"errorcode"' in body[:200]:
        raise OSError(json.loads(body).get("message", "download refused"))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    with open(tmp, "wb") as f:
        f.write(body)
    os.replace(tmp, dest)
    if mtime:
        try:
            os.utime(dest, (mtime, mtime))
        except OSError:
            pass


