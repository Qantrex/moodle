def subject_of(course, overrides):
    """Subject code of a course: an override, else the code in the short name, else the subject's name,
    else an upper-case code in the full name. Plain words like "am" or "E-Learning" don't count as AM or E."""
    short, full = course.get("shortname") or "", course.get("fullname") or ""
    lower = {k.lower(): v for k, v in overrides.items()}
    for key in (short, full):
        if key in overrides:
            return overrides[key] or None                       # "": ignore this course
        if key.lower() in lower:
            return lower[key.lower()] or None

    def code_in(text, flags=0):
        return next((c for c in SUBJECTS
                     if re.search(r"(?<![A-Za-zÄÖÜäöü])%s(?![A-Za-zÄÖÜäöü]|-[A-Za-z])" % c, text, flags)), None)

    text = ("%s %s" % (short, full)).lower()
    return (code_in(short, re.I)
            or next((c for c, ws in SUBJECTS.items() if any(re.search(w, text) for w in ws)), None)
            or code_in(full))


def school_year(course):
    for m in re.finditer(r"\b(\d{2})\s*/\s*(\d{2})\b", course.get("fullname", "") + " " + course.get("shortname", "")):
        if int(m.group(2)) == (int(m.group(1)) + 1) % 100:     # 26/27, not a date like 10/12
            return "20%s-%s" % (m.group(1), m.group(2))
    t = local(course["startdate"] if course.get("startdate") else now_ts())
    y = t.year if t.month >= 7 else t.year - 1                # courses set up in July/August belong to the new year
    return "%d-%02d" % (y, (y + 1) % 100)


def current(course):
    end = course.get("enddate") or 0
    return not end or end > now_ts() - 30 * 86400            # running, or ended less than a month ago


_run_cache = {}
WORKERS = 4                                                     # parallel API calls: few, to stay polite


def cached_call(fn, **args):
    """call(), but each (function, arguments) only once per run: site info and the course list are needed by
    several steps."""
    key = (fn, json.dumps(args, sort_keys=True))
    if key not in _run_cache:
        _run_cache[key] = call(fn, **args)
    return copy.deepcopy(_run_cache[key])


def site_info():
    return cached_call("core_webservice_get_site_info")


def courses(all_years=False):
    cs = cached_call("core_enrol_get_users_courses", userid=site_info()["userid"])
    overrides = {}
    try:
        with open(SUBJECTS_FILE, encoding="utf-8") as f:
            overrides = json.load(f)
        if not isinstance(overrides, dict):
            raise ValueError("not a {\"course\": \"SUBJECT\"} object")
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        log("moodle: ignoring %s: %s" % (SUBJECTS_FILE, e))
        overrides = {}
    out = []
    for c in cs:
        if not all_years and not current(c):
            continue
        c["subject"] = subject_of(c, overrides)
        c["year"] = school_year(c)
        out.append(c)
    return out


def merge_files(*lists):
    seen, out = set(), []
    for lst in lists:
        for f in lst or []:
            if not isinstance(f, dict) or not f.get("filename") or not f.get("fileurl"):
                continue
            name = os.path.basename(f["filename"])
            keys = {(name, f["fileurl"])}
            if f.get("filesize") is not None and f.get("timemodified"):
                keys.add((name, f["filesize"], f["timemodified"]))     # same file listed under another URL
            if not keys & seen:
                seen |= keys
                out.append(f)
    return out


def submissions_enabled_in_configs(configs):
    if not configs:
        return True
    return any(
        c.get("subtype") == "assignsubmission" and c.get("name") == "enabled" and str(c.get("value")) == "1"
        and c.get("plugin") != "comments"
        for c in configs
    )


def status_of(assign_id, subs_enabled=True):
    try:
        s = call("mod_assign_get_submission_status", assignid=assign_id)
    except (TokenError, NetworkError):
        raise
    except MoodleError as e:
        log("  note: status unavailable for assign %d (%s)" % (assign_id, e))
        return {"state": "?" if subs_enabled else "none", "graded": False, "grade": None,
                "feedback": "", "files": [], "activity": ""}
    last = s.get("lastattempt") or {}
    enabled = subs_enabled and bool(last.get("submissionsenabled", True))
    sub = (last.get("teamsubmission") or last.get("submission") or {})
    raw_state = sub.get("status")
    if raw_state in ("submitted", "reopened"):
        state = raw_state
    elif not enabled:
        state = "none"
    else:
        state = raw_state or "new"
    fb = s.get("feedback") or {}
    comments = []
    for p in fb.get("plugins") or []:
        if p.get("type") == "comments":
            for ef in p.get("editorfields") or []:
                t = text_of(ef.get("text"))
                if t:
                    comments.append(t)
    att = ((s.get("assignmentdata") or {}).get("attachments") or {})
    return {
        "state": state,
        "graded": last.get("gradingstatus") == "graded",
        "grade": fb.get("gradefordisplay") and text_of(fb["gradefordisplay"]),
        "feedback": "\n\n".join(comments),
        "files": merge_files(att.get("intro"), att.get("activity")),
        "activity": text_of((s.get("assignmentdata") or {}).get("activity") or ""),
    }


def enrich_status(items):
    if not items:
        return items
    read_token()                                                # warm token cache before spawning threads
    with ThreadPoolExecutor(max_workers=min(WORKERS, len(items))) as ex:
        sts = list(ex.map(lambda a: status_of(a["id"], a["subs_enabled"]), items))
    for a, st in zip(items, sts):
        a.update(state=st["state"], graded=st["graded"], grade=st["grade"],
                 feedback=st["feedback"], activity=st["activity"],
                 files=merge_files(a["files"], st["files"]))
    return items


def assignments(all_years=False, with_status=True):
    cs = {c["id"]: c for c in courses(all_years)}
    if not cs:
        return []
    res = call("mod_assign_get_assignments", courseids=list(cs))
    out = []
    for c in res.get("courses", []):
        course = cs.get(c["id"])
        if not course:
            continue
        for x in c.get("assignments", []):
            clean_name = re.sub(r"\s+", " ", html.unescape(x["name"]).replace("\xa0", " ")).strip()
            out.append(dict(
                id=x["id"], cmid=x["cmid"], name=clean_name,
                course=course.get("shortname") or course["fullname"],
                subject=course["subject"], year=course["year"],
                due=x.get("duedate") or 0, cutoff=x.get("cutoffdate") or 0,
                opens=x.get("allowsubmissionsfromdate") or 0,
                subs_enabled=submissions_enabled_in_configs(x.get("configs")),
                intro=text_of(x.get("intro")),
                files=merge_files(x.get("introattachments"), x.get("introfiles")),
                url="%s/mod/assign/view.php?id=%d" % (SITE, x["cmid"]),
            ))
    out.sort(key=lambda a: (a["due"] == 0, a["due"], a["subject"] or "", a["name"]))
    if with_status:
        enrich_status(out)
    return out


