def browser_url(u):
    """Turn token-gated /webservice/pluginfile.php links into regular SSO /pluginfile.php links."""
    u = (u or "").strip()
    u = re.sub(r"([?&])(?:ws)?token=[^&#]*(&|(?=#)|$)", lambda m: m.group(1) if m.group(2) else "", u)
    u = re.sub(r"[?&](?=#|$)", "", u)                            # never copy a token into a note
    return u.replace(SITE + "/webservice/pluginfile.php/", SITE + "/pluginfile.php/")


class _MDParser(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []
        self.skip = 0
        self.pre = 0
        self.code = 0
        self.lists = []          # [["ul", items so far, inside an <li>], ["ol", 2, True], ...]
        self.in_li = 0
        self.li_has_text = False
        self.links = []          # [(href, start_idx)]
        self.marks = []          # [(marker, start_idx, active)]
        self.table = None        # rows: [[cell_str, ...], ...]
        self.tables = 0          # nesting depth: inner tables are flattened into the outer cell
        self.cell = None         # list of chunks when inside td/th

    def _buf(self):
        return self.cell if self.cell is not None else self.out

    def _emit(self, s):
        if not self.skip and s:
            self._buf().append(s)

    def _tail(self):
        b = self._buf()
        return "".join(b[-4:]) if b else ""

    def _nl(self, n=1):
        b = self._buf()
        if self.skip or self.cell is not None:
            if self.cell is not None and self.cell:
                self.cell.append(" ")
            return
        while b and b[-1] in (" ", "\t"):
            b.pop()
        if not b or not any(x.strip() for x in b):
            return
        t = self._tail()
        have = len(t) - len(t.rstrip("\n"))
        if have < n:
            self._emit("\n" * (n - have))

    def _open_mark(self, marker):
        active = not any(m == marker and act for m, _, act in self.marks)
        self.marks.append((marker, len(self._buf()), active))

    def _close_mark(self, marker):
        b = self._buf()
        for idx in range(len(self.marks) - 1, -1, -1):
            if self.marks[idx][0] == marker:
                _, start, active = self.marks.pop(idx)
                if not active:
                    return
                inner = "".join(b[start:])
                del b[start:]
                core = inner.strip()
                if not core:
                    b.append(inner)
                else:
                    lead = inner[:len(inner) - len(inner.lstrip())]
                    trail = inner[len(inner.rstrip()):]
                    b.append("%s%s%s%s" % (lead, marker, core, marker + trail))
                return

    def handle_startendtag(self, tag, attrs):
        if tag.lower() not in HTML_TAGS:
            raw = self.get_starttag_text() or ("<%s/>" % tag)
            self._emit(raw if (self.pre or self.code) else "\\" + raw)
        else:
            super().handle_startendtag(tag, attrs)

    def handle_starttag(self, tag, attrs):
        t = tag.lower()
        if t not in HTML_TAGS:
            raw = self.get_starttag_text() or ("<%s>" % tag)
            self._emit(raw if (self.pre or self.code) else "\\" + raw)
            return
        at = dict(attrs)
        if t in ("script", "style"):
            self.skip += 1
        elif t == "br":
            if self.cell is not None:
                self._emit(" ")
            else:
                self._emit("\n")
        elif t == "hr":
            self._nl(2)
            self._emit("---\n\n")
        elif t in ("p", "div", "blockquote"):
            if self.in_li and not self.li_has_text:
                pass
            elif self.in_li:
                self._nl(1)
                self._emit("  " * len(self.lists))
            else:
                self._nl(2)
            if t == "blockquote" and self.cell is None:
                self._emit("> ")
        elif t in ("h1", "h2", "h3", "h4", "h5", "h6"):
            self._nl(2)
            self._open_mark("**")
        elif t in ("strong", "b"):
            if not self.pre:
                self._open_mark("**")
        elif t in ("em", "i"):
            if not self.pre:
                self._open_mark("*")
        elif t == "pre":
            if self.cell is not None:
                self._open_mark("`")
            else:
                self._nl(2)
                self._emit("```\n")
            self.pre += 1
        elif t == "code":
            if not self.pre:
                self.code += 1
                self._open_mark("`")
        elif t in ("ul", "ol"):
            self._nl(1 if self.lists else 2)
            self.lists.append([t, 0, False])
        elif t == "li":
            self._nl(1)
            if not self.lists:
                self.lists.append(["ul", 0, False])
            if self.lists[-1][2]:                               # <li> without </li> before the next one
                self.in_li = max(0, self.in_li - 1)
            self.lists[-1][1] += 1
            self.lists[-1][2] = True
            kind, num, _ = self.lists[-1]
            indent = "  " * (len(self.lists) - 1)
            self._emit("%s%s" % (indent, ("%d. " % num) if kind == "ol" else "- "))
            self.in_li += 1
            self.li_has_text = False
        elif t == "a":
            self.links.append((browser_url(at.get("href")), len(self._buf())))
        elif t == "img":
            src = browser_url(at.get("src"))
            alt = (at.get("alt") or "").strip()
            if src.startswith("data:"):                         # a pasted screenshot: megabytes of base64
                self._emit("*(image%s)*" % (": " + alt if alt else ""))
            elif src:
                self._emit("![%s](%s)" % (alt, src))
        elif t == "table":
            self.tables += 1
            if self.tables == 1:
                self._end_cell()
                self._nl(2)
                self.table = []
            else:
                self._emit(" ")
        elif t == "tr":
            if self.tables > 1:
                self._emit(" ")
            elif self.table is not None:
                self._end_cell()
                self.table.append([])
        elif t in ("td", "th"):
            if self.tables > 1:
                self._emit(" ")
            elif self.table is not None:
                self._end_cell()                                # </td> is optional in HTML
                if not self.table:
                    self.table.append([])
                self.cell = []

    def handle_endtag(self, tag):
        t = tag.lower()
        if t not in HTML_TAGS:
            self._emit(("</%s>" if (self.pre or self.code) else r"\</%s>") % tag)
            return
        if t in ("script", "style"):
            self.skip = max(0, self.skip - 1)
        elif t in ("p", "div", "blockquote"):
            if not self.in_li:
                self._nl(2)
        elif t in ("h1", "h2", "h3", "h4", "h5", "h6"):
            self._close_mark("**")
            self._nl(2)
        elif t in ("strong", "b"):
            if not self.pre:
                self._close_mark("**")
        elif t in ("em", "i"):
            if not self.pre:
                self._close_mark("*")
        elif t == "pre":
            self.pre = max(0, self.pre - 1)
            if self.cell is not None:
                self._close_mark("`")
            else:
                if not self._tail().endswith("\n"):
                    self._emit("\n")
                self._emit("```\n\n")
        elif t == "code":
            if not self.pre and self.code:
                self.code -= 1
                self._close_mark("`")
        elif t in ("ul", "ol"):
            if self.lists:
                if self.lists[-1][2]:
                    self.in_li = max(0, self.in_li - 1)
                self.lists.pop()
            self._nl(1 if self.lists else 2)
        elif t == "li":
            if self.lists and self.lists[-1][2]:
                self.lists[-1][2] = False
                self.in_li = max(0, self.in_li - 1)
            self._nl(1)
        elif t == "a":
            if self.links:
                href, start = self.links.pop()
                b = self._buf()
                label = "".join(b[start:]).strip()
                del b[start:]
                if not href or href.startswith(("javascript:", "#")):
                    b.append(label)
                elif not label or label == href:
                    b.append(href)
                else:
                    b.append("[%s](%s)" % (label, href))
        elif t in ("td", "th"):
            if self.tables == 1:
                self._end_cell()
        elif t == "table":
            self.tables = max(0, self.tables - 1)
            if self.tables == 0 and self.table is not None:
                self._end_cell()
                rows = [r for r in self.table if any(r)]
                self.table = None
                if rows:
                    cols = max(len(r) for r in rows)
                    rows = [r + [""] * (cols - len(r)) for r in rows]
                    lines = ["| " + " | ".join(rows[0]) + " |", "|" + "---|" * cols]
                    lines += ["| " + " | ".join(r) + " |" for r in rows[1:]]
                    self._emit("\n".join(lines) + "\n\n")

    def _end_cell(self):
        if self.cell is not None and self.table:
            txt = re.sub(r"\s+", " ", "".join(self.cell)).strip().replace("|", r"\|")
            self.table[-1].append(txt)
        self.cell = None

    def close(self):
        super().close()
        if self.table is not None:                              # unclosed table at the end: keep its text
            self.tables = 1
            self.handle_endtag("table")

    def handle_data(self, data):
        if self.skip or not data:
            return
        s = data.replace("\r\n", "\n").replace("\r", "\n")
        if not self.pre:
            s = s.replace("\xa0", " ")
            s = re.sub(r"[ \t\n]+", " ", s)
            if self._tail().endswith(("\n", "- ", ". ")) and not self.marks and not self.links:
                s = s.lstrip(" ")
            if not self.code:
                s = re.sub(r"<(?=[A-Za-z/!])(?!https?://|mailto:)", r"\<", s)
        if s.strip() and self.in_li:
            self.li_has_text = True
        self._emit(s)


def text_of(htm):
    """Convert Moodle HTML into clean Markdown while preserving links, formatting and non-HTML <placeholders>."""
    if not htm:
        return ""
    p = _MDParser()
    p.feed(htm)
    p.close()
    s = "".join(p.out)
    lines = [line.rstrip(" \t") for line in s.split("\n")]
    return re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()


