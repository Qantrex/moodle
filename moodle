def load_tz():
    """Due dates are shown in the school's time zone, not the machine's (a server or CI may run in UTC)."""
    name = os.environ.get("MOODLE_TZ") or CONFIG.get("timezone") or "Europe/Vienna"
    try:
        return ZoneInfo(name)
    except (ZoneInfoNotFoundError, ValueError):
        print("moodle: unknown time zone %r, using the machine's" % name, file=sys.stderr)
        return None


