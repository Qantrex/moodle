# ---- API ------------------------------------------------------------------------------------------------------

def flatten(prefix, v, out):
    if isinstance(v, (list, tuple)):
        for i, x in enumerate(v):
            flatten("%s[%d]" % (prefix, i), x, out)
    elif isinstance(v, dict):
        for k, x in v.items():
            flatten("%s[%s]" % (prefix, k), x, out)
    else:
        out.append((prefix, str(v)))


def call(fn, token=None, **args):
    """One web-service call. Raises TokenError, NetworkError (after retries) or MoodleError; never shows the token."""
    data = [("wstoken", token or read_token()), ("wsfunction", fn), ("moodlewsrestformat", "json")]
    for k, v in args.items():
        flatten(k, v, data)
    req = urllib.request.Request(SITE + "/webservice/rest/server.php", data=urllib.parse.urlencode(data).encode(),
                                 headers={"User-Agent": UA})
    for attempt in range(len(RETRY_DELAYS) + 1):
        retry = True
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                raw = r.read().decode("utf-8", "replace")
            out = json.loads(raw)
            break
        except urllib.error.HTTPError as e:
            why, retry = "HTTP %d" % e.code, e.code in RETRY_HTTP
        except urllib.error.URLError as e:
            why = e.reason
        except (OSError, http.client.HTTPException) as e:       # timeouts, resets, cut-off answers
            why = "%s %s" % (type(e).__name__, e)
        except ValueError:
            why = "the answer isn't JSON (maintenance page?)"
        if not retry or attempt == len(RETRY_DELAYS):
            raise NetworkError("can't reach %s: %s" % (SITE, redact(why)), "network")
        time.sleep(RETRY_DELAYS[attempt])
    if isinstance(out, dict) and (out.get("exception") or ("errorcode" in out and "error" in out)):
        code = out.get("errorcode") or "unknown"
        if code in TOKEN_ERRORS or (code == "accessexception" and fn.startswith("core_")):
            raise TokenError("Moodle refused the token (%s). Run `moodle token` again." % code, code)
        raise MoodleError("%s: %s" % (fn, redact(out.get("message") or out.get("error") or code)), code)
    return out


class DownloadError(Exception):
    pass


def download(url, dest, token, mtime=None, size=None):
    """Fetch one attachment into dest (atomically). The token only ever goes to SITE, and no error names the URL."""
    if not url.startswith(SITE + "/"):
        raise DownloadError("not on %s, skipped (the token only goes to Moodle)" % SITE)
    if size and int(size) > MAX_DOWNLOAD:
        raise DownloadError("%.0f MB, over the %d MB limit (MOODLE_MAX_MB)" % (int(size) / 2 ** 20, MAX_DOWNLOAD >> 20))
    url = urllib.parse.quote(url, safe=":/?&=%#+@,;~!$'()*[]")    # spaces etc. would make urllib raise with the URL
    sep = "&" if "?" in url else "?"
    req = urllib.request.Request(url + sep + urllib.parse.urlencode({"token": token}), headers={"User-Agent": UA})
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dest), prefix=".", suffix=".part")
    try:
        try:
            with os.fdopen(fd, "wb") as f, urllib.request.urlopen(req, timeout=60) as r:
                length = r.headers.get("Content-Length")
                if length and length.isdigit() and int(length) > MAX_DOWNLOAD:
                    raise DownloadError("over the %d MB limit (MOODLE_MAX_MB)" % (MAX_DOWNLOAD >> 20))
                head, total = b"", 0
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > MAX_DOWNLOAD:
                        raise DownloadError("over the %d MB limit (MOODLE_MAX_MB)" % (MAX_DOWNLOAD >> 20))
                    if len(head) < 512:
                        head += chunk[:512]
                    f.write(chunk)
        except urllib.error.HTTPError as e:
            raise DownloadError("HTTP %d" % e.code) from None
        except (OSError, ValueError, http.client.HTTPException) as e:
            raise DownloadError(redact("%s %s" % (type(e).__name__, getattr(e, "reason", e)))) from None
        if head.lstrip()[:1] == b"{" and b'"errorcode"' in head and total < 1 << 16:
            try:
                with open(tmp, "rb") as f:
                    err = json.load(f)
            except ValueError:
                err = None
            if isinstance(err, dict) and err.get("errorcode"):
                raise DownloadError(redact(err.get("error") or err.get("message") or err["errorcode"]))
        os.chmod(tmp, 0o666 & ~UMASK)
        os.replace(tmp, dest)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    if mtime:
        try:
            os.utime(dest, (int(mtime), int(mtime)))
        except OSError:
            pass


class Downloads:
    """Remembers what was downloaded where (STATE/downloads.json), so a sync never overwrites a file you edited
    and doesn't fetch an unchanged attachment again."""

    def __init__(self):
        self.path = os.path.join(STATE, "downloads.json")
        try:
            with open(self.path, encoding="utf-8") as f:
                self.seen = json.load(f)
        except (OSError, ValueError):
            self.seen = {}
        self.dirty = False

    @staticmethod
    def remote(f):
        return int(f.get("timemodified") or 0), int(f.get("filesize") if f.get("filesize") is not None else -1)

    def plan(self, dest, f):
        """'get' (missing or replaced in Moodle), 'skip' (up to date or your own edit, Moodle unchanged)
        or 'beside' (Moodle has a new version but the local file was edited: keep it, save the new one next to it)."""
        if not os.path.exists(dest):
            return "get"
        st = os.stat(dest)
        tm, size = self.remote(f)
        rec = self.seen.get(os.path.abspath(dest))
        if rec:
            untouched = rec["lsize"] == st.st_size and rec["lmtime"] == int(st.st_mtime)
            same = (rec["tm"], rec["size"]) == (tm, size)
            return "skip" if same else ("get" if untouched else "beside")
        # No record (older versions, or a file that was already there). Older versions set mtime := timemodified.
        ours = tm and abs(int(st.st_mtime) - tm) <= 1
        if size < 0 or st.st_size == size:
            self.remember(dest, f)
            return "skip"
        return "get" if ours else "beside"

    def remember(self, dest, f):
        st = os.stat(dest)
        tm, size = self.remote(f)
        self.seen[os.path.abspath(dest)] = {"tm": tm, "size": size, "lsize": st.st_size, "lmtime": int(st.st_mtime)}
        self.dirty = True

    def save(self):
        if self.dirty:
            write_atomic(self.path, json.dumps(self.seen, indent=0, sort_keys=True) + "\n")
            self.dirty = False


def beside_name(fname, f):
    stem, ext = os.path.splitext(fname)
    return "%s (Moodle %s)%s" % (stem, day(int(f.get("timemodified") or now_ts())), ext)


def read_text(path):
    """A note's text, or None (with a warning) if it isn't UTF-8: such a file is never rewritten."""
    try:
        with open(path, encoding="utf-8", newline="") as f:
            return f.read()
    except UnicodeDecodeError:
        log("  skipping %s: not UTF-8" % path)
        return None


def write_atomic(path, text):
    """Write via a temp file + rename, so a crash or a syncing vault never sees a half-written file."""
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    try:
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        mode = 0o666 & ~UMASK
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".", suffix=".moodle-tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


