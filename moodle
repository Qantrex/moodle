def cmd_courses(a):
    for c in courses(a.all):
        print("%-6s %-8s %-28s %s" % (c["subject"] or "?", c["year"], c.get("shortname", "")[:28], c.get("fullname", "")))


def cmd_list(a):
    items = assignments(a.all, with_status=False)
    if not a.all:
        items = [x for x in items if x["subject"] and not PLACEHOLDER.search(x["name"])
                 and (not a.dated or x["due"])
                 and (not x["due"] or x["due"] > now_ts() - 30 * 86400)]
    enrich_status(items)
    if not a.all:
        items = [x for x in items if not done(x)]
    if a.json:
        print(json.dumps(items, ensure_ascii=False, indent=1))
        return
    for x in items:
        late = x["due"] and x["due"] < now_ts() and not done(x)
        state = "no-upload" if x.get("state") == "none" else x.get("state", "?")
        print("%-17s %-5s %-10s %s%s  %s" % (when(x["due"])[4:] if x["due"] else "–", x["subject"] or "?",
                                             state, "LATE " if late else "", x["name"][:60], x["url"]))


def cmd_show(a):
    cmid = parse_cmid(a.assignment)
    x = next((x for x in assignments(all_years=True, with_status=False) if x["cmid"] == cmid), None)
    if not x:
        fail("assignment %d isn't in my courses (or Moodle hides it)" % cmid)
    enrich_status([x])
    if a.json:
        print(json.dumps(x, ensure_ascii=False, indent=1))
        return
    state = "no online submission" if x.get("state") == "none" else x.get("state")
    print("%s: %s\n%s\nDue: %s%s\nSubmission: %s%s" % (
        x["subject"] or x["course"], x["name"], x["url"], when(x["due"]),
        " (cut-off %s)" % when(x["cutoff"]) if x["cutoff"] and x["cutoff"] != x["due"] else "",
        state, ", graded: %s" % x["grade"] if x.get("grade") else ""))
    if x.get("feedback"):
        print("Feedback: " + x["feedback"])
    if x["files"]:
        print("Files: " + ", ".join(os.path.basename(f["filename"]) for f in x["files"]))
    if x["intro"]:
        print("\n" + x["intro"])
    act = extra_instructions(x)
    if act:
        print("\nInstructions:\n" + act)


def main():
    ap = argparse.ArgumentParser(prog="moodle", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("token", help="one-time setup through TGM single sign-on").set_defaults(fn=cmd_token)
    s = sub.add_parser("courses", help="enrolled courses and their subject")
    s.add_argument("--all", action="store_true", help="also past years")
    s.set_defaults(fn=cmd_courses)
    s = sub.add_parser("list", help="open assignments, dated + undated (--all: everything)")
    s.add_argument("--all", action="store_true", help="include finished, older and unmapped items")
    s.add_argument("--dated", action="store_true", help="only assignments with a due date")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("show", help="one assignment in full")
    s.add_argument("assignment", help="link like …/mod/assign/view.php?id=25720, or the id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)
    s = sub.add_parser("add", help="create folder (<Task Name>.md + TASK.md) + working folder for specific task(s)")
    s.add_argument("assignments", nargs="+", help="assignment link(s) or id(s)")
    s.add_argument("--no-files", action="store_true", help="don't create the working folder or download attachments")
    s.add_argument("--force", action="store_true", help="create even if already finished/graded")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser("sync", help="refresh existing tracker notes (never bulk-creates folders)")
    s.add_argument("--no-files", action="store_true", help="don't download attachments")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_sync)
    a = ap.parse_args()
    try:
        a.fn(a)
    except MoodleError as e:
        fail(str(e), e.exit_code)
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:                                      # a bug: say what, but never with the token in it
        if os.environ.get("MOODLE_DEBUG"):
            import traceback
            log(traceback.format_exc())
        fail("unexpected %s: %s" % (type(e).__name__, e))


if __name__ == "__main__":
    main()
