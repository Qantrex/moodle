def load_config():
    """Personal settings from ~/.config/moodle/config.toml. They stay on this machine, never in this repo."""
    path = os.path.join(CONF, "config.toml")
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as e:
        sys.exit("moodle: %s: %s" % (path, e))


