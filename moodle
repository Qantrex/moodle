class MoodleError(Exception):
    """Moodle answered with an error. code is Moodle's errorcode (or ours: network, token, …)."""
    exit_code = EXIT_ERROR

    def __init__(self, msg, code="error"):
        super().__init__(msg)
        self.code = code


class TokenError(MoodleError):
    exit_code = EXIT_TOKEN


class NetworkError(MoodleError):
    exit_code = EXIT_NETWORK


def redact(s):
    """Never let the token reach the terminal, a log or a note, even inside an error message."""
    s = str(s)
    if _token_cache and len(_token_cache) >= 8:
        s = s.replace(_token_cache, "***")
    return re.sub(r"((?:ws)?token=)[A-Za-z0-9+/=_%-]{8,}", r"\1***", s)


def log(*a):
    print(*(redact(x) for x in a), file=sys.stderr)


def fail(msg, code=EXIT_ERROR):
    log("moodle: " + msg)
    sys.exit(code)


# ---- token ----------------------------------------------------------------------------------------------------

def read_token():
    global _token_cache
    if _token_cache:
        return _token_cache
    if os.environ.get("MOODLE_TOKEN", "").strip():             # e.g. from a systemd EnvironmentFile on a server
        _token_cache = os.environ["MOODLE_TOKEN"].strip()
        return _token_cache
    cmd = os.environ.get("MOODLE_TOKEN_CMD")                 # e.g. 'rbw get "TGM Moodle token"'
    if cmd:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            _token_cache = r.stdout.strip()
            return _token_cache
        fail("MOODLE_TOKEN_CMD failed (exit %d)" % r.returncode, EXIT_TOKEN)
    try:
        with open(TOKEN_FILE) as f:
            _token_cache = f.read().strip()
    except OSError:
        _token_cache = None
    if not _token_cache:
        fail("no token yet: run `moodle token` once (in a normal terminal)", EXIT_TOKEN)
    return _token_cache


def parse_token(raw, passport):
    """A plain 32-hex token, or the moodlemobile://token=<base64> link that the SSO launch redirects to."""
    raw = raw.strip()
    if re.fullmatch(r"[0-9a-f]{32}", raw):
        return raw
    m = re.search(r"token=([A-Za-z0-9+/=_-]+)", raw)
    if not m:
        fail("that's neither a token nor a moodlemobile://token=… link")
    b64 = m.group(1).replace("-", "+").replace("_", "/")
    try:
        parts = base64.b64decode(b64 + "=" * (-len(b64) % 4)).decode().split(":::")
    except ValueError:                                          # binascii.Error, UnicodeDecodeError
        fail("the link is damaged (copy the whole location header)")
    if len(parts) < 2:
        fail("the link doesn't contain a token")
    if passport and parts[0] != hashlib.md5((SITE + passport).encode()).hexdigest():
        log("warning: the link wasn't made for this login request (old link?); trying the token anyway")
    return parts[1]


